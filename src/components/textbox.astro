---
const { text, image, title } = Astro.props;
---

<div style="margin: 13px; margin-top: unset">
  <div id="textbox" style="width: 100%;">
    <div style="padding: 6px; padding-left: 12px;">
      <span style="text-decoration: underline;">{title}</span>
    </div>

    <hr style="width: 100%; height: 4px; border: unset !important" />

    <div style="display: flex;padding: 20px;padding-top: 16px;width: 100%">
      <div style="font-size: 21px; max-width: 600px;" set:html={text} />
      <div style="min-width: 120px; min-height: 100%; margin-left: 12px">
        <img src={image} style="width: 100%;height: 100%"/>
      </div>
    </div>
  </div>
</div>

<style>
  #textbox {
    outline: 5px solid var(--secondary-color);
    width: 100%;
    color: var(--secondary-color);
    background-color: var(--misc-color);
    user-select: none;
    margin-top: 5px;
  }

  #textbox :global(b) {
    color: var(--secondary-color) !important;
  }

  hr {
    background-color: var(--secondary-color);
  }
</style>
