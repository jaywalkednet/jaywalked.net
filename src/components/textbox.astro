---
const { text, image, title } = Astro.props;
---
<div style="margin: 20px; margin-top: unset">
  <div id="textbox" style="width: 100%;">
    <div style="padding: 6px; padding-left: 12px;">
      <span style="text-decoration: underline;">{title}</span>
    </div>

    <hr style="width: 100%; height: 4px; border: unset !important"/>

    <div style="display: flex;padding: 20px;padding-top: 16px;width: 100%">
      <div style="font-size: 21px; max-width: 650px;" set:html={text}/>
      <img src={image} style="height: 120px;user-drag: none; user-select: none;"/>
    </div>
  </div>
</div>

<style>
  #textbox {
    outline: 5px solid var(--main-color);
    width: 100%;
    color: var(--main-color) !important;
    user-select: none;
    margin-top: 5px;
  }

  #textbox :global(b) {
    color: var(--main-color) !important;
  }

  #image{
    max-width: 120px;
    width: 100%;
    height: auto;
    margin-left: 12px;
    display: flex;
    align-items: center;
    filter: var(--filter);
  }

  @media only screen and (max-width: 500px){
    #image{
      display: none;
    }
  }

  hr {
    background-color: var(--main-color);
  }
</style>
