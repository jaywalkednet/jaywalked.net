---
import '../components/global.css';
import '../components/home.css';
import DarkMode from '../components/dark_mode.astro';
import TextBox from '../components/textbox.astro';
---

<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>jaywalked</title>
    <meta property="og:title" content="jaywalked">
    <meta property="og:description" content="jaywalking is cool, and totally legal!">
    <meta property="og:image" content="/favicon.png">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <script is:inline>
      if (localStorage.getItem('darkmode') === "true"){
        document.documentElement.classList.add('darkmode');
      } 
    </script>

    <script>
      import "../components/global.js"
      import "../components/darkmode.js"
    </script>
  </head>

  <body style="overflow: hidden">  
    <div class="center fadeIn">
      <div class="content" style="width: 800px">
        <img src="Logo.svg" style="margin-bottom: 0px; width: 90%">
        <div id="social" class="interactable_c" style="margin: 16px 0 12px 0">
            <img src="yt.svg" onclick="move_page('https://www.youtube.com/@jaywalked', 'blank')">
            <img src="insta.svg" onclick="move_page('https://www.instagram.com/jaywalkednet/', 'blank')">
            <img src="itchio.svg" onclick="move_page('https://jaywalked.itch.io/', 'blank')">  
            <img src="gamejolt.svg" onclick="move_page('https://gamejolt.com/@jaywalked', 'blank')">   
        </div>
        <TextBox title="information" image="Circle.svg" text="<b>my name is jay</b>, a black male creating multiple forms of media, most notably game development. i work on multiple projects, create 2D & 3D art/animation, graphic design and video edit.<br><b>feel free to check out my portfolio!</b>"/>
        <button class="button interactable" onclick="move_page('portfolio', 'self')">check out my portfolio!</button>
        <span style="text-align: center"><br>note 12/9/26: this website will be getting a design overhaul in the near future!</span>
      </div>
    </div>
    <DarkMode/>
  </body>
</html>
